# Copy to `.env` (same folder) and fill in. `.env` is gitignored — nothing
# secret is committed. docker compose reads this file automatically.

# Linux uid Airflow runs as inside the container. 50000 is the image default;
# on Windows Docker Desktop you can leave it as-is.
AIRFLOW_UID=50000

# Host path to your GCP service-account key, mounted read-only into the
# container. Use FORWARD SLASHES on Windows.
GCP_KEYFILE_HOST=C:/Users/sayee/.gcp/dbt-runner-key.json

# Local Airflow web login (http://localhost:8080). Local only.
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow
